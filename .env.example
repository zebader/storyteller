# Groq API key for story generation (https://console.groq.com/keys)
# Server-side only: read by server/index.js, never sent to the browser
GROQ_API_KEY=

# Optional: Groq model (defaults to openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: stories each visitor can create per hour (defaults to 15, 0 disables the limit)
# STORIES_PER_HOUR=15
